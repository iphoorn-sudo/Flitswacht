{
  "name": "Flitswacht",
  "short_name": "Flitswacht",
  "description": "Persoonlijke, richtingsbewuste flitserwaarschuwing voor Nederland, België en Luxemburg op basis van OpenStreetMap (geen live mobiele flitsers).",
  "lang": "nl",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#070b10",
  "theme_color": "#070b10",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
